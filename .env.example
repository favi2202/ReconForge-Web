# Connected owner mode is disabled unless both variables are set.
CONNECTED_MODE=false
APP_ACCESS_TOKEN=

# Comma-separated origins. Wildcards are rejected.
CORS_ALLOWLIST=http://localhost:5173

# Optional official Brave Search API adapter.
BRAVE_SEARCH_API_KEY=

# Optional passive intelligence adapters. Server-side secrets only.
URLSCAN_API_KEY=
SHODAN_API_KEY=

API_HOST=127.0.0.1
API_PORT=8787
RATE_LIMIT_MAX=30
RUN_QUERY_LIMIT=20
RUN_RESULT_LIMIT=100
PROVIDER_TIMEOUT_MS=8000
BRAVE_DAILY_QUERY_LIMIT=200
URLSCAN_DAILY_QUERY_LIMIT=100
SHODAN_DAILY_QUERY_LIMIT=25
LOG_LEVEL=info
