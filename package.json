{
  "name": "reconforge-web",
  "version": "0.2.0",
  "private": true,
  "description": "A defensive passive reconnaissance planner and analyst workspace.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace @reconforge/web",
    "dev:api": "npm run dev --workspace @reconforge/api",
    "build:packages": "npm run build --workspace @reconforge/core && npm run build --workspace @reconforge/templates",
    "build": "npm run build --workspace @reconforge/core && npm run build --workspace @reconforge/templates && npm run build --workspace @reconforge/api && npm run build --workspace @reconforge/web",
    "build:pages": "npm run build:pages --workspace @reconforge/web",
    "verify:release": "node scripts/verify-release.mjs",
    "verify:licenses": "node scripts/verify-licenses.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build --workspace @reconforge/web && node scripts/run-e2e.mjs",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit": "npm audit --audit-level=high"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.6.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
